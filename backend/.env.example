# CyberPilot Environment Configuration

# ── Core Application ─────────────────────────────────────────────────────────
APP_PORT=8000
# Comma-separated list of allowed CORS origins.
# In development, localhost:5173 and common dev ports are allowed by default.
# In production (APP_ENV=production), set this explicitly — do NOT use "*".
# APP_CORS_ORIGINS=https://app.cyberpilot.local

# ── AI Engine / Ollama Integration (Phase 3) ────────────────────────────────
# AI is completely optional. When disabled (or unavailable), CyberPilot
# functions as a standard security scanner with no AI features.

# Enable AI analysis layer. Set to "true" to use Ollama for finding analysis.
# When false, the MockAIProvider is used (deterministic, for testing).
AI_ENABLED=false

# Ollama server URL (do not expose credentials here — Ollama is local-only)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use for analysis (must be pulled locally via `ollama pull <model>`)
OLLAMA_MODEL=phi3

# Maximum seconds to wait for an Ollama response
OLLAMA_TIMEOUT=60

# ── OWASP ZAP Integration (Phase 4) ──────────────────────────────────────────
# ZAP is optional. When unavailable, web/API scans are skipped with a
# clear NOT_INSTALLED status — the app does NOT crash.

# ZAP daemon API base URL (change if running on a different host/port)
ZAP_BASE_URL=http://localhost:8080

# ZAP API key (if configured). Leave empty for default (no key).
ZAP_API_KEY=

# ZAP scan mode: passive (safe, default), baseline, or active (intrusive, opt-in)
ZAP_MODE=passive

# Auto-start a local ZAP daemon when not already running.
# Requires ZAP to be installed and on PATH (java -jar zap.sh or zap.bat).
ZAP_AUTOSTART=true

# Allow scanning private/localhost targets (SSRF safety toggle)
# Set to "true" ONLY for authorized local testing — never in production.
ZAP_ALLOW_PRIVATE_TARGETS=false

# Maximum seconds to wait for ZAP daemon to start
ZAP_STARTUP_TIMEOUT=30

# Maximum seconds for a ZAP scan to run
ZAP_SCAN_TIMEOUT=300

# Maximum seconds for ZAP spidering
ZAP_SPIDER_TIMEOUT=120

# Maximum number of child processes for ZAP
ZAP_MAX_CHILDREN=1

# ── Trivy Integration (Phase 7B) ────────────────────────────────────────────
# Trivy is optional. When unavailable, filesystem/repo scans return NOT_INSTALLED.

# Severity threshold for Trivy vulnerability scans
# Trivy accepts: UNKNOWN, LOW, MEDIUM, HIGH, CRITICAL (INFO is NOT valid)
TRIVY_SEVERITY=HIGH,CRITICAL,MEDIUM

# Skip Trivy database update on scan (use cached DB). Set to false on first run.
TRIVY_SKIP_DB_UPDATE=true

# Maximum seconds for a Trivy scan to run
TRIVY_TIMEOUT=300
