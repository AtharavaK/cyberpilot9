# CyberPilot Environment Configuration
# Copy this file to .env and customize.

# ── Core Application ─────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Default: http://localhost:5173,http://127.0.0.1:5173
# Do NOT use "*" — credential-bearing requests require explicit origins.
# Set explicitly in production to your frontend's origin(s).
# APP_CORS_ORIGINS=https://app.cyberpilot.local

# Vite proxy target (frontend dev server proxies /api to backend)
VITE_API_PROXY_TARGET=http://localhost:8000

# ── Frontend API URL ─────────────────────────────────────────────────────────
# Used as the fallback API base URL if no stored URL is set in localStorage.
# VITE_API_URL=http://localhost:8000/api/v1

# ── AI Analysis ──────────────────────────────────────────────────────────────
# AI analysis is disabled by default (MockAIProvider is always available).
# Enable Ollama integration by setting AI_ENABLED=true and configuring an
# Ollama server.
# AI_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=phi3
# OLLAMA_TIMEOUT=60

# ── OWASP ZAP ────────────────────────────────────────────────────────────────
# ZAP scanner configuration. Only needed if ZAP is installed and used.
# ZAP_BASE_URL=http://localhost:8080
# ZAP_API_KEY=
# ZAP_MODE=passive
# ZAP_EXECUTABLE=zap.sh

# ── SSRF Protection ──────────────────────────────────────────────────────────
# By default, ZAP scanning blocks private/internal IP targets to prevent
# SSRF. Set this to "true" to allow private targets (for lab environments
# only — use with extreme caution).
# ZAP_ALLOW_PRIVATE_TARGETS=false
